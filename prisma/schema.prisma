generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Role {
  SUPER_ADMIN
  REPORTS
  OPERATIONS
  COUNSELLING_TL
  COUNSELLING_AGENT
}

enum Feature {
  VIEW_REPORTS
  DOWNLOAD_DATA
  MASK_UNMASK_DATA
  UPLOAD_LEADS
  /// Adding ONE lead by hand, from the + in the header. Deliberately separate
  /// from UPLOAD_LEADS, which also carries the Upload Leads page and bulk CSV
  /// import — every role may add a lead they just spoke to without thereby
  /// being able to import a file of ten thousand.
  ADD_SINGLE_LEAD
  APPROVE_LEADS
  ASSIGN_LEADS
  VIEW_LEADS
  SUBMIT_FEEDBACK
  APPROVE_RECEIPTS
  /// Maintaining the lists under Manage Dropdowns — colleges, courses and
  /// feedback options. Separate from being a Super Admin so a back-office
  /// role can curate the lists without also gaining user management, bulk
  /// delete and the Configurations screens that sit under the same route.
  MANAGE_DROPDOWNS
  /// Creating KPI definitions and setting targets. Split from MANAGE_DROPDOWNS
  /// because "who may edit the course list" and "who may set the floor's
  /// numbers" are different questions with different answers.
  MANAGE_KPI
}

enum LeadStatus {
  PENDING
  APPROVED
  DISAPPROVED
}

enum DropdownType {
  COLLEGE
  /// The course list the Add Lead form and CSV upload validate against.
  /// Maintained by a Super Admin under Manage Dropdowns rather than pulled
  /// from the LMS, so the floor offers the courses this team actually sells.
  COURSE
  /// A lead code (the `campaign` field on a Lead) mapped to the Data Calling
  /// Type every lead carrying that code should show. See lib/lead-code.ts.
  LEAD_CODE
  LEAD_TYPE
  LEAD_ORIGIN
  ZONE
  LEAD_CONFIRMATION
  LEAD_STAGE
  LEAD_VERIFICATION
  DATA_CALLING_TYPE
  DEAL_TYPE
}

enum BatchStatus {
  PROCESSING
  COMPLETED
  FAILED
}

enum ScheduledCallStatus {
  PENDING
  DONE
  CANCELLED
}

enum NotificationType {
  LEAD_ASSIGNED
  // The ingestion API moved one of the agent's leads to a new stage. Sent only
  // when the lead is actually assigned to someone — an unassigned lead has
  // nobody to tell.
  LEAD_STAGE_CHANGED
  CALL_REMINDER
  CALL_NOW
  /// A lead rang in and nobody picked up. Raised from the dialer webhook when
  /// it reports term_reason ABANDON and the sticky tag names a CRM agent.
  MISSED_CALL
  RECEIPT_SUBMITTED
  RECEIPT_APPROVED
  RECEIPT_DISAPPROVED
}

enum AnnouncementPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum UserStatus {
  ACTIVE
  INACTIVE
  PENDING_APPROVAL // TL-requested agents awaiting SA approval
}

enum ReceiptType {
  APPLICATION
  ADMISSION
}

enum ReceiptStatus {
  PENDING
  APPROVED
  DISAPPROVED
}

enum WorkType {
  WFH
  WFO
}

enum BreakType {
  LUNCH
  BIO
  TEA
}

enum ActivityAction {
  USER_CREATED
  USER_UPDATED
  USER_DEACTIVATED
  USER_APPROVED
  USER_REJECTED
  LEAD_ASSIGNED
  LEAD_APPROVED
  LEAD_DISAPPROVED
  LEAD_DELETED
  FEEDBACK_SUBMITTED
  PERMISSION_CHANGED
  CSV_UPLOADED
  TEAM_CREATED
  TEAM_UPDATED
  AGENT_TRANSFER
  TL_TRANSFER
  PASSWORD_CHANGED
  BATCH_APPROVED
  BATCH_DISAPPROVED
  REFERRAL_ADDED
  RECEIPT_APPROVED
  RECEIPT_DISAPPROVED
  API_KEY_CREATED
  API_KEY_REVOKED
  LEAD_CREATED_VIA_API
  SECURITY_PIN_CHANGED
  SECURITY_ACTION_UNLOCKED
  LEAD_INTEGRATION_CREATED
  LEAD_INTEGRATION_UPDATED
  LEAD_INTEGRATION_DELETED
  /// Edits to a university profile. What counsellors quote on calls, so
  /// every change to one is worth a trail.
  ///
  /// UNIVERSITY_IMPORTED is retired — profiles are maintained by hand now —
  /// but the value stays so existing log rows keep resolving.
  UNIVERSITY_IMPORTED
  UNIVERSITY_CREATED
  UNIVERSITY_UPDATED
  UNIVERSITY_DELETED
  LEADS_EXPORTED
}

// Which CRM event fires a configured push — only referral-lead creation for
// now (that's the one concrete need); more triggers can be added to this
// enum later without touching the LeadIntegration table shape.
enum LeadIntegrationTrigger {
  REFERRAL_CREATED
  /// A lead arrives in the CRM for the integration's college (CSV upload, API,
  /// single add or an extra interest merged onto an existing student).
  LEAD_CREATED
}

/// For a LEAD_CREATED integration: when the push goes out.
enum LeadPushWhen {
  /// The moment the lead is inserted, whatever its approval status.
  ON_INSERT
  /// Held until the lead is approved, so unapproved or rejected leads never
  /// reach the college.
  ON_APPROVAL
}

/// Where a KPI's number comes from. A KPI is defined by picking one of these
/// and then narrowing it with the fields on KpiDefinition, so a new KPI is
/// configuration rather than code.
enum KpiSource {
  /// Feedback the agent logged in the period, optionally narrowed to particular
  /// feedback options or whole categories. Leave both empty to count them all.
  FEEDBACK_COUNT
  /// Distinct leads the agent gave that feedback to at ANY point in the period
  /// — use this when repeat follow-ups on one lead should count once, and when
  /// a later follow-up should not erase the earlier one (milestones such as
  /// Admission Done).
  FEEDBACK_LEADS
  /// Distinct leads whose LATEST follow-up in the period matches — a lead
  /// marked Hot and later moved to Warm counts as Warm only. This is the rule
  /// the All Leads pills use, so it is the one for states rather than
  /// milestones.
  FEEDBACK_LEADS_LATEST
  /// A live count of the agent's assigned leads currently at the chosen Lead
  /// Stage(s). A snapshot: it ignores the period and the same lead keeps
  /// counting while it sits there.
  LEAD_STAGE_LIVE
  /// Approved receipts for the agent's leads in the period, by date paid.
  RECEIPT_COUNT
  /// Leads assigned to the agent during the period.
  LEADS_ASSIGNED
  /// No source — a target can be set but achievement is left blank, for things
  /// the CRM genuinely cannot see.
  NOT_MEASURED
}

enum KpiPeriod {
  DAILY
  WEEKLY
  MONTHLY
  QUARTERLY
}

// ─── Core Models ──────────────────────────────────────────────────────────────

model User {
  id           String     @id @default(cuid())
  name         String
  email        String     @unique
  password     String
  role         Role
  status       UserStatus @default(ACTIVE)
  isActive     Boolean    @default(true)
  employeeCode String     @unique
  phone        String?
  workType     WorkType   @default(WFO)
  /// Which zone this agent covers — the same five values colleges use, so the
  /// two line up on reports. Null until an admin sets it.
  zone         String?
  /// Languages the agent can counsel in, free text (e.g. "Hindi, English").
  /// Deliberately not a dropdown: the list is long, regional and changes often,
  /// and a wrong-but-close value here is harmless.
  language     String?
  joiningDate  DateTime   @default(now())
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  // Second-factor 6-digit PIN gating especially destructive Super Admin
  // tools (e.g. Bulk Delete Leads) — separate from the account password.
  // Null until the admin sets one up from their profile page.
  securityPinHash           String?
  securityPinSetAt          DateTime?
  securityPinFailedAttempts Int                         @default(0)
  securityPinLockedUntil    DateTime?
  adminActionUnlocks        AdminActionUnlock[]
  priorityAssignmentEdits   PriorityAssignmentSetting[] @relation("PriorityAssignmentUpdatedBy")
  reassignmentRules         ReassignmentRule[]          @relation("ReassignmentRuleCreatedBy")
  attendancePolicyEdits     AttendancePolicy[]          @relation("AttendancePolicyUpdatedBy")

  // KPIs and targets this user has authored. Both are organisation-wide rather
  // than per user, so there is no inverse "targets for me" relation.
  kpiDefinitions KpiDefinition[] @relation("KpiDefinitionCreatedBy")
  kpiTargetsSet  KpiTarget[]     @relation("KpiTargetSetBy")
  emailRules     EmailRule[]     @relation("EmailRuleCreatedBy")
  emailRuleScope EmailRule[]     @relation("EmailRuleScopeTl")

  // Generic manager link (SA → TL, TL → Agent, SA → Operations)
  managerId String?
  manager   User?   @relation("UserManager", fields: [managerId], references: [id])
  reports   User[]  @relation("UserManager")

  // Legacy TL→Agent relation kept for compatibility
  managedById String?
  managedBy   User?   @relation("TLAgents", fields: [managedById], references: [id])
  agents      User[]  @relation("TLAgents")

  // Team membership (TL is teamLead, Agents are members)
  teamId String?
  team   Team?   @relation("TeamMembers", fields: [teamId], references: [id])

  // Teams this user leads
  ledTeams Team[] @relation("TeamLead")

  // Operations group membership
  operationsGroupId String?
  operationsGroup   OperationsGroup? @relation("GroupMembers", fields: [operationsGroupId], references: [id])

  // Teams created by SA
  createdTeams            Team[]            @relation("TeamCreator")
  createdOperationsGroups OperationsGroup[] @relation("GroupCreator")
  managedGroups           OperationsGroup[] @relation("GroupManager")

  // Lead relations
  uploadedLeads            Lead[]                @relation("UploadedBy")
  approvedLeads            Lead[]                @relation("ApprovedBy")
  disapprovedLeads         Lead[]                @relation("DisapprovedBy")
  assignedLeads            Lead[]                @relation("AssignedTo")
  assignedByLeads          Lead[]                @relation("AssignedBy")
  assignedFromLeads        Lead[]                @relation("AssignedFrom")
  prevAssignee2Leads       Lead[]                @relation("PrevAssignee2")
  feedbacks                LeadFeedback[]
  archivedFeedbacks        LeadFeedbackArchive[] @relation("ArchivedFeedbackAgent")
  archivedFeedbacksResetBy LeadFeedbackArchive[] @relation("ArchivedFeedbackBy")
  uploadBatches            UploadBatch[]

  scheduledCalls          ScheduledCall[]   @relation("AgentSchedules")
  notifications           Notification[]
  uploadedReceipts        LeadReceipt[]     @relation("ReceiptUploadedBy")
  reviewedReceipts        LeadReceipt[]     @relation("ReceiptReviewedBy")
  attendances             Attendance[]
  apiKeysCreated          ApiKey[]          @relation("ApiKeyCreatedBy")
  leadIntegrationsCreated LeadIntegration[] @relation("LeadIntegrationCreatedBy")

  // Feedback options created by this user (SA)
  createdFeedbackOptions FeedbackOption[] @relation("FeedbackOptionCreator")

  // Feedback categories (Hot/Warm/Cold etc.) created by this user (SA)
  createdFeedbackCategories FeedbackCategory[] @relation("FeedbackCategoryCreator")

  // Dropdown options created by this user (SA)
  createdDropdownOptions DropdownOption[] @relation("DropdownOptionCreator")
  updatedUniversities    University[]     @relation("UniversityUpdatedBy")

  // Activity log
  activityLogs ActivityLog[]

  // Announcements authored by this user (SA)
  announcements Announcement[]

  // Rejection reason when SA rejects a TL-requested agent
  rejectionReason String?

  // Daily upload limit (null = unlimited). Only meaningful for OPERATIONS role.
  uploadLimit Int?

  @@index([role])
  @@index([teamId])
  @@index([isActive])
  @@index([role, isActive])
}

/// A KPI the organisation measures — created and edited from the KPI page
/// rather than defined in code, so a new one is a form, not a release.
///
/// `source` chooses the shape of the query and the fields below narrow it. Only
/// the fields relevant to the chosen source are read; the rest stay empty.
model KpiDefinition {
  id     String    @id @default(cuid())
  name   String    @unique
  /// Shown after the number, e.g. "calls", "leads", "min".
  unit   String    @default("")
  source KpiSource

  /// FEEDBACK_COUNT / FEEDBACK_LEADS — narrow to these options, and/or every
  /// option in these categories. Both empty means "any feedback".
  feedbackOptionIds   String[]
  feedbackCategoryIds String[]
  /// LEAD_STAGE_LIVE — the Lead Stage values that count.
  leadStages          String[]
  /// RECEIPT_COUNT — which receipt type counts.
  receiptType         ReceiptType?

  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  createdById String
  createdBy   User   @relation("KpiDefinitionCreatedBy", fields: [createdById], references: [id])

  targets   KpiTarget[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([isActive, sortOrder])
}

/// One organisation-wide target per KPI per period length.
///
/// Deliberately not per agent: the same expectation applies to everyone, so
/// changing it is a single edit and a new joiner is measured from day one.
/// Cascades with its definition — deleting a KPI takes its targets with it.
///
/// Targets are absolute counts for the period: a DAILY target of 50 means 50
/// per day, not 50 spread across the week.
model KpiTarget {
  id           String        @id @default(cuid())
  definitionId String
  definition   KpiDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)

  period KpiPeriod
  target Int

  /// What hitting this target is worth, for the agent scoreboard. Null means the
  /// KPI is tracked but not scored, so a team can measure something without it
  /// affecting anyone's total.
  points Int?

  setById String
  setBy   User   @relation("KpiTargetSetBy", fields: [setById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([definitionId, period])
}

model Team {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  teamLeadId String?
  teamLead   User?   @relation("TeamLead", fields: [teamLeadId], references: [id])

  createdById String
  createdBy   User   @relation("TeamCreator", fields: [createdById], references: [id])

  members User[] @relation("TeamMembers")
  leads   Lead[] @relation("TeamLeads")
}

model OperationsGroup {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  managerId String
  manager   User   @relation("GroupManager", fields: [managerId], references: [id])

  createdById String
  createdBy   User   @relation("GroupCreator", fields: [createdById], references: [id])

  members User[] @relation("GroupMembers")
}

model Permission {
  id        String  @id @default(cuid())
  role      Role
  feature   Feature
  canAccess Boolean @default(false)

  @@unique([role, feature])
}

model Lead {
  id            String     @id @default(dbgenerated("('LID' || nextval('lead_id_seq'::regclass))"))
  name          String
  email         String
  phone         String
  city          String?
  state         String?
  course        String?
  college       String?
  kappCollegeId String?
  campaign      String?
  leadType      String?
  leadOrigin    String?
  leadZone      String?
  status        LeadStatus @default(PENDING)

  uploadedById String
  uploadedBy   User   @relation("UploadedBy", fields: [uploadedById], references: [id])

  // Set only for leads created through POST /api/v1/leads — lets an admin
  // trace a lead back to the specific partner integration that sent it.
  apiKeyId String?
  apiKey   ApiKey? @relation("LeadCreatedByApiKey", fields: [apiKeyId], references: [id])

  approvedById String?
  approvedBy   User?     @relation("ApprovedBy", fields: [approvedById], references: [id])
  approvedAt   DateTime?

  disapprovedById   String?
  disapprovedBy     User?     @relation("DisapprovedBy", fields: [disapprovedById], references: [id])
  disapprovedAt     DateTime?
  disapprovalReason String?

  assignedToId String?
  assignedTo   User?     @relation("AssignedTo", fields: [assignedToId], references: [id])
  assignedAt   DateTime?

  assignedById String?
  assignedBy   User?   @relation("AssignedBy", fields: [assignedById], references: [id])

  assignedFromId String?
  assignedFrom   User?   @relation("AssignedFrom", fields: [assignedFromId], references: [id])

  prevAssignee2Id String?
  prevAssignee2   User?   @relation("PrevAssignee2", fields: [prevAssignee2Id], references: [id])

  batchId String?
  batch   UploadBatch? @relation(fields: [batchId], references: [id])

  // Team the lead is assigned to (set when TL assigns to agent)
  teamId String?
  team   Team?   @relation("TeamLeads", fields: [teamId], references: [id])

  feedbacks      LeadFeedback[]
  stageHistory   LeadStageEntry[]
  interests      LeadInterest[]
  profile        LeadProfile?
  scheduledCalls ScheduledCall[]
  receipts       LeadReceipt[]

  // Archived feedback from before the most recent "reassign as fresh" reset —
  // preserved for TL/Super Admin visibility even though the live `feedbacks`
  // relation above is cleared so the newly-assigned agent sees a clean lead.
  archivedFeedbacks LeadFeedbackArchive[]

  // Incremented every time this lead is reassigned "as fresh" (resetFeedbacks).
  // Feedback archived under a given reset is stamped with the cycle number it
  // belonged to, so historical follow-ups can be grouped by assignment period.
  currentCycle Int @default(1)

  // True when the CURRENT assignment (assignedTo/assignedAt/assignedBy above)
  // was made with resetFeedbacks — surfaced on the Timeline's "Assigned to X"
  // event so other roles can see that a fresh reset happened.
  lastAssignmentWasFresh Boolean @default(false)

  // Extra upload fields
  primaryApplicationConfirm String?
  primaryAdmissionConfirm   String?
  leadConfirmation          String?
  // The lead's CURRENT stage. Kept as a plain column so the leads table,
  // filters, CSV export and dropdown filtering all keep working unchanged —
  // `stageHistory` below is additive, not a replacement.
  leadStage                 String?
  leadVerification          String?
  dataCallingType           String?
  dealType                  String?
  uploadedAt                DateTime?

  // Referral chain — a lead can refer any number of new leads; the referred
  // lead is auto-assigned to the agent handling the referring lead
  referredById String?
  referredBy   Lead?   @relation("LeadReferrals", fields: [referredById], references: [id])
  referrals    Lead[]  @relation("LeadReferrals")

  // Push history when this lead triggered an external integration (e.g. LMS push)
  integrationLogs   LeadIntegrationLog[]
  integrationPushes LeadIntegrationPush[]

  // Tracks the most recent feedback option — updated on every feedback submit
  currentFeedbackOptionId String?

  // Verified / corrected student contact details (filled by counsellor)
  altEmail1    String?
  altEmail2    String?
  altPhone1    String?
  altPhone2    String?
  correctCity  String?
  correctState String?

  // Basic student info captured on the Lead Profile page
  parentName   String?
  parentMobile String?
  gender       String?
  classYear    String?
  category     String? // General, SC/ST, OBC, EWS

  createdAt DateTime @default(now())
  // Deliberately NOT `@updatedAt`. This column means "when feedback was last
  // submitted for this lead", not "when the row last changed" — the Leads table
  // shows it as UPDATED AT and the Updated Date Range filter reads it, and
  // counsellors rely on it to see genuine call activity.
  //
  // With `@updatedAt`, any incidental write bumped it: moving an agent to a
  // different Team Lead rewrites `teamId` on every one of their leads
  // (lib/team-sync.ts), which restamped hundreds of rows to the same instant
  // and buried the real activity.
  //
  // Because it has no default, Prisma requires it on create, so the compiler
  // catches every new write site. Set it ONLY where feedback is submitted:
  // app/api/leads/[id]/feedback/route.ts.
  updatedAt DateTime

  @@index([status])
  @@index([assignedToId])
  @@index([teamId])
  @@index([uploadedById])
  @@index([batchId])
  @@index([status, teamId])
  @@index([status, assignedToId])
  @@index([kappCollegeId])
  @@index([referredById])
  @@index([apiKeyId])
}

model LeadProfile {
  id                         String   @id @default(cuid())
  leadId                     String   @unique
  lead                       Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  budget                     String?
  preferredCourseIds         Json? // number[] — references CourseList.csv course_id
  preferredCollegeIds        Json? // number[] — references CollegeList.csv college_id
  preferredCityNames         Json? // string[]
  preferredStateNames        Json? // string[]
  courseType                 String? // "Regular" | "Online"
  collegeType                String? // "Government" | "Private" | "Government+Private"
  specialisation             String?
  entranceExam               Json? // string[]
  scholarshipAwareness       String?
  loanRequirement            String?
  loanAmount                 String?
  paymentModePreference      String?
  stayPreference             String?
  monthlyAccommodationBudget String?
  roomSharing                String?
  mealsPreference            String?
  keyAmenities               Json? // string[]
  distanceWillingness        String?
  genderHostelRequirement    String?
  class10Percentage          String?
  class12Percentage          String?
  board                      String?
  gapYearReason              String?
  mediumOfInstruction        String?
  updatedAt                  DateTime @updatedAt
}

model FeedbackCategory {
  id        String   @id @default(cuid())
  name      String   @unique
  color     String   @default("#64748b") // hex color chosen via color picker — see lib/feedback-category-colors.ts
  sortOrder Int      @default(0)
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  creator         User             @relation("FeedbackCategoryCreator", fields: [createdBy], references: [id])
  feedbackOptions FeedbackOption[]

  @@index([sortOrder])
}

model FeedbackOption {
  id          String   @id @default(cuid())
  label       String
  description String?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  categoryId  String?
  createdBy   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  creator           User                  @relation("FeedbackOptionCreator", fields: [createdBy], references: [id])
  category          FeedbackCategory?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  feedbacks         LeadFeedback[]
  archivedFeedbacks LeadFeedbackArchive[]

  @@index([isActive])
  @@index([isActive, sortOrder])
  @@index([categoryId])
}

model DropdownOption {
  id                  String       @id @default(cuid())
  type                DropdownType
  value               String
  // COLLEGE-only. A lead's Zone and Deal Type are properties of the college it
  // belongs to, so they are configured here once and copied onto every lead
  // ingested for that college (API and CSV) instead of being sent per lead.
  collegeZone         String?
  collegeDealType     String?
  /// COLLEGE-only: whether this college is a paying client. Read live whenever
  /// a lead is listed rather than copied onto the lead, so setting it later
  /// updates every existing lead for that college instead of only new ones.
  collegeClientType   String?
  // COLLEGE-only as well: the college's application landing page, handed to
  // students by counsellors. Stored as a template containing {{%agent%}}, which
  // is replaced with the reading agent's ID at display time so the click is
  // attributed to whoever shared it. See lib/landing-page.ts.
  landingPageUrl      String?
  /// LEAD_CODE-only: the Data Calling Type every lead with this code takes.
  /// Holds one of the DATA_CALLING_TYPE option values rather than an id, so the
  /// value written onto Lead.dataCallingType is the same string the filters and
  /// the CSV export already work with.
  leadCodeCallingType String?
  isActive            Boolean      @default(true)
  sortOrder           Int          @default(0)
  createdBy           String
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  creator User @relation("DropdownOptionCreator", fields: [createdBy], references: [id])

  /// COLLEGE-only: the lead-push integrations configured for this college.
  collegeIntegrations LeadIntegration[] @relation("CollegeIntegrations")

  /// One row per value per type. A college is identified by its name now, so
  /// the name is the key: two colleges cannot share one, and CSV upload and the
  /// API both resolve a lead's college against it.
  @@unique([type, value])
  @@index([type, isActive])
  @@index([type, isActive, sortOrder])
}

// Every lead stage a lead has been through, with when it arrived.
//
// The ingestion API re-sends the same lead as its stage advances. Previously
// that was rejected outright as a duplicate, so the progression was lost; now
// each new stage is appended here and Lead.leadStage is moved to the latest.
// A stage may legitimately recur (L1 -> L2 -> L1), so there is deliberately no
// unique constraint on (leadId, stage) — the API only skips a repeat of the
// stage the lead is *currently* on.
model LeadStageEntry {
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  stage     String
  // Where the stage came from — 'API', 'CSV' or 'MANUAL'. Useful when a stage
  // looks wrong and someone needs to know which pipeline produced it.
  source    String?
  createdAt DateTime @default(now())

  @@index([leadId, createdAt])
  @@index([stage])
}

/// One college/course a lead has enquired about.
///
/// A student who asks about B.Tech at one college and later about MBA at
/// another is one person, not two leads. Identity is email + phone; when a
/// lead with that identity arrives carrying a college or course it has not
/// shown interest in before, the lead is reused and a row is added here
/// rather than a second lead being created.
///
/// `Lead.college` and `Lead.course` always hold the LATEST interest, so every
/// existing filter, export and report keeps working untouched. This table is
/// the history behind them, and its row count is what drives the "+1" badge
/// in All Leads.
model LeadInterest {
  id     String @id @default(cuid())
  leadId String
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  college String?
  course  String?

  /// Where it came from — 'API', 'CSV' or 'MANUAL', matching LeadStageEntry.
  source    String?
  createdAt DateTime @default(now())

  @@index([leadId, createdAt])
}

model LeadFeedback {
  id               String         @id @default(cuid())
  leadId           String
  lead             Lead           @relation(fields: [leadId], references: [id], onDelete: Cascade)
  agentId          String
  agent            User           @relation(fields: [agentId], references: [id])
  feedbackOptionId String
  feedbackOption   FeedbackOption @relation(fields: [feedbackOptionId], references: [id])
  remarks          String?
  followUpNumber   Int
  createdAt        DateTime       @default(now())

  @@index([leadId])
  @@index([agentId])
  @@index([feedbackOptionId])
  @@index([createdAt])
}

// Snapshot of a LeadFeedback row moved out of the live LeadFeedback table
// when a lead is reassigned "as fresh" (resetFeedbacks). The live table is
// cleared so the newly-assigned agent sees a clean lead, but nothing is ever
// destroyed — TL/Super Admin/Reports can still see it here via the Timeline.
model LeadFeedbackArchive {
  id               String         @id @default(cuid())
  leadId           String
  lead             Lead           @relation(fields: [leadId], references: [id], onDelete: Cascade)
  agentId          String
  agent            User           @relation("ArchivedFeedbackAgent", fields: [agentId], references: [id])
  feedbackOptionId String
  feedbackOption   FeedbackOption @relation(fields: [feedbackOptionId], references: [id])
  remarks          String?
  followUpNumber   Int
  createdAt        DateTime // original feedback creation time, preserved as-is

  cycle        Int // which assignment cycle (Lead.currentCycle at the time) this belonged to
  archivedAt   DateTime @default(now())
  archivedById String?
  archivedBy   User?    @relation("ArchivedFeedbackBy", fields: [archivedById], references: [id])

  @@index([leadId])
  @@index([leadId, cycle])
  /// Every performance figure now reads this table alongside LeadFeedback (see
  /// lib/feedback-history.ts), so it needs the same access pattern indexed:
  /// one agent over a date window.
  @@index([agentId, createdAt])
  @@index([createdAt])
}

model UploadBatch {
  id               String      @id @default(cuid())
  fileName         String
  uploadedById     String
  uploadedBy       User        @relation(fields: [uploadedById], references: [id])
  totalRecords     Int
  insertedRecords  Int         @default(0)
  duplicateRecords Int         @default(0)
  errorRecords     Int         @default(0)
  status           BatchStatus @default(COMPLETED)
  createdAt        DateTime    @default(now())

  leads Lead[]
}

model ScheduledCall {
  id           String              @id @default(cuid())
  leadId       String
  lead         Lead                @relation(fields: [leadId], references: [id], onDelete: Cascade)
  agentId      String
  agent        User                @relation("AgentSchedules", fields: [agentId], references: [id])
  scheduledAt  DateTime
  note         String?
  status       ScheduledCallStatus @default(PENDING)
  reminderSent Boolean             @default(false)
  nowSent      Boolean             @default(false)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([agentId, scheduledAt])
  @@index([status, scheduledAt])
  @@index([agentId, status, reminderSent])
}

model LeadReceipt {
  id     String      @id @default(cuid())
  type   ReceiptType
  leadId String
  lead   Lead        @relation(fields: [leadId], references: [id], onDelete: Cascade)

  campusName        String
  couponCodeApplied Boolean @default(false)
  referralCode      String?

  paidDate      DateTime
  receiptNumber String // Application Form Number / Admission Number
  actualAmount  String?
  amountPaid    String // Final Amount Paid / Admission Amount Paid

  courseId   String
  courseName String

  studentName String
  email       String
  altEmail    String?
  mobile      String
  altMobile   String?

  city  String?
  state String

  fileOriginalName String
  filePath         String // on-disk path, relative to the private storage root
  fileMimeType     String
  fileSize         Int

  uploadedById String
  uploadedBy   User   @relation("ReceiptUploadedBy", fields: [uploadedById], references: [id])

  // Super Admin approval workflow — approving flips the lead's matching
  // Primary App./Adm. Confirm field to "Yes"; disapproving lets the agent
  // fix and resend (upload a fresh receipt of the same type).
  status            ReceiptStatus @default(PENDING)
  reviewedById      String?
  reviewedBy        User?         @relation("ReceiptReviewedBy", fields: [reviewedById], references: [id])
  reviewedAt        DateTime?
  disapprovalReason String?

  createdAt DateTime @default(now())

  @@index([leadId])
  @@index([type])
  @@index([uploadedById])
  @@index([status])
}

model Notification {
  id         String           @id @default(cuid())
  userId     String
  user       User             @relation(fields: [userId], references: [id])
  type       NotificationType
  title      String
  body       String
  leadId     String?
  // The exact leads a bulk "N leads assigned" notification refers to.
  //
  // Without it the drill-down had to guess, by looking for leads touched within
  // ±5 minutes of the notification. That guess broke outright once Lead.updatedAt
  // stopped tracking assignments (it now moves only on feedback), and it was
  // never reliable anyway — two assignments minutes apart contaminated each
  // other. Recording the ids at write time removes the guesswork; `leadId` above
  // still covers single-lead notifications.
  //
  // Capped when stored (see the assign routes): the viewer pages through at most
  // a hundred, so there is no reason to keep thousands of ids on one row.
  leadIds    String[]
  scheduleId String?
  read       Boolean          @default(false)
  createdAt  DateTime         @default(now())

  @@index([userId, read])
  @@index([userId, createdAt])
}

model ActivityLog {
  id          String         @id @default(cuid())
  userId      String
  user        User           @relation(fields: [userId], references: [id])
  action      ActivityAction
  targetId    String?
  targetType  String? // "User" | "Lead" | "Team" | "Permission"
  description String
  metadata    Json?
  createdAt   DateTime       @default(now())

  @@index([userId])
  @@index([createdAt])
  @@index([action])
}

model Announcement {
  id        String               @id @default(cuid())
  title     String
  content   String
  priority  AnnouncementPriority @default(NORMAL)
  isActive  Boolean              @default(true)
  createdBy String
  author    User                 @relation(fields: [createdBy], references: [id])
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  @@index([isActive, createdAt])
}

model Attendance {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  // Calendar day this shift belongs to, "YYYY-MM-DD" in Asia/Kolkata — a
  // plain string sidesteps the naive-timestamp/timezone-cast pitfalls this
  // codebase has already been bitten by (see lib/scheduled-call-notifications.ts).
  date String

  punchInAt  DateTime
  punchOutAt DateTime?

  // Active and idle time are BOTH accumulated incrementally from the
  // client's heartbeat — never derived from (punchOutAt - punchInAt). That
  // elapsed-time approach would silently keep "working" time running for as
  // long as a shift stays open, even after the agent closes the CRM tab
  // entirely. A heartbeat only exists while the tab is open, so time the tab
  // is closed contributes to neither bucket — it's simply not measured.
  activeSeconds Int @default(0)
  idleSeconds   Int @default(0)

  // Last time any attendance action (punch/break/heartbeat) was recorded for
  // this shift — used to infer a punch-out time if the shift is never
  // explicitly closed (browser closed, laptop shut, etc).
  lastHeartbeatAt DateTime?

  // True if punchOutAt was inferred (auto-closed) rather than explicitly clicked.
  autoClosed Boolean @default(false)

  /// The device's IP at check-in, for spotting a shift marked from somewhere it
  /// should not have been. Null on every shift recorded before this was added,
  /// and null when no forwarding header reaches the app.
  punchInIp String?

  /// Whether this check-in was after the cutoff in AttendancePolicy.
  ///
  /// Decided once, at check-in, and stored — not recomputed from punchInAt on
  /// read. An admin moving the cutoff later must not retroactively make
  /// yesterday's on-time agents late, which is exactly what a derived value
  /// would do. Always false while the cutoff is switched off.
  isLate Boolean @default(false)

  /// Where the shift was started from, when the browser supplied it.
  /// `punchInDistanceM` is metres from the configured office at that moment —
  /// kept so an admin can see a borderline check-in rather than only its
  /// pass/fail verdict.
  punchInLatitude  Float?
  punchInLongitude Float?
  punchInDistanceM Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  breaks AttendanceBreak[]

  @@unique([userId, date])
  @@index([userId, date])
  @@index([date])
}

model AttendanceBreak {
  id           String     @id @default(cuid())
  attendanceId String
  attendance   Attendance @relation(fields: [attendanceId], references: [id], onDelete: Cascade)
  startAt      DateTime
  endAt        DateTime?

  // Null on breaks recorded before break categorization existed — those are
  // bucketed as "Other" in reports rather than guessed into one of the three.
  type BreakType?

  @@index([attendanceId])
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// Credentials for external systems pushing leads into the CRM via
// POST /api/v1/leads (see that route for the full contract). The raw key is
// shown to the Super Admin exactly once at creation time and is never
// persisted — only its SHA-256 hash is stored, so a database leak alone
// can't be used to authenticate as an integration.
model ApiKey {
  id String @id @default(cuid())

  name String // human label, e.g. "Partner LMS — Referral Leads"

  keyHash   String @unique // sha256(raw key) — never store the raw key
  keyPrefix String // first 12 chars of the raw key, shown in the UI so an admin can tell keys apart without re-revealing them

  isActive   Boolean   @default(true)
  lastUsedAt DateTime?

  createdById String
  createdBy   User   @relation("ApiKeyCreatedBy", fields: [createdById], references: [id])

  revokedAt DateTime?

  createdAt DateTime @default(now())

  leads Lead[] @relation("LeadCreatedByApiKey")

  @@index([keyHash])
  @@index([createdById])
}

// A short-lived grant that a Super Admin has verified their security PIN for
// a specific gated action (e.g. "BULK_DELETE_LEADS"). Scoped per action, not
// global, so unlocking one PIN-gated tool never unlocks another. Checked
// server-side by the protected routes themselves — the frontend PIN prompt
// is UX, this row is the actual enforcement.
/// Auto-assignment of incoming leads by Data Calling Type.
///
/// One row, id "singleton" — this is a setting, not a list. A lead arriving
/// with one of `dataCallingTypes` is handed to the next agent in `agentIds`,
/// round-robin. See lib/priority-assignment.ts.
model PriorityAssignmentSetting {
  id String @id @default("singleton")

  /// Super Admin's master switch. Off means incoming leads are untouched.
  isEnabled Boolean @default(false)

  /// Which Data Calling Types trigger it. Empty means it never fires — a rule
  /// that matched everything by default would be a nasty way to find out it
  /// was left on.
  dataCallingTypes String[]

  /// Who leads go to, in order. Held as ids rather than a join table: the set
  /// is small, edited wholesale, and always re-checked against live agents at
  /// assign time, so a deactivated agent simply drops out.
  agentIds String[]

  /// Round-robin position. Incremented atomically by the size of each batch,
  /// so two concurrent uploads take disjoint ranges instead of both starting
  /// from the same agent.
  cursor Int @default(0)

  /// Running totals, so the page can show that it is actually doing something.
  assignedCount  Int       @default(0)
  lastAssignedAt DateTime?

  updatedById String?
  updatedBy   User?    @relation("PriorityAssignmentUpdatedBy", fields: [updatedById], references: [id])
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())
}

/// A standing rule that moves stale leads to a different counsellor.
///
/// "Stale" is measured on the lead's LATEST feedback: a lead whose newest
/// follow-up is older than `staleDays` has sat without progress for that long.
/// A lead with no feedback at all never matches — the rule is about feedback
/// that stopped changing, not about leads nobody has touched yet.
///
/// Rules are evaluated by the scheduler (see /api/cron/reassign-leads) and can
/// also be previewed or run by hand from Configurations → Re-assign Leads.
model ReassignmentRule {
  id       String  @id @default(cuid())
  name     String
  /// Off by default: a rule is written, previewed, and only then switched on.
  isActive Boolean @default(false)

  /// Which current feedback the lead must carry. Options and whole categories
  /// are OR-ed together; both empty means "any feedback".
  feedbackOptionIds   String[]
  feedbackCategoryIds String[]

  /// Whole days the latest feedback must have sat unchanged. At least 1 — a
  /// rule firing the moment feedback is logged would fight the counsellor.
  staleDays Int

  /// Who the leads may go to. Empty means every active counselling agent, and
  /// is re-checked live on each run so a deactivated agent drops out on its
  /// own. The lead's current owner is always skipped.
  agentIds String[]

  /// Round-robin position, carried between runs so the rotation continues
  /// rather than restarting from the first agent every time.
  cursor Int @default(0)

  /// Most leads one run may move. A guard against a newly-written rule
  /// matching thousands of leads and redistributing the whole floor at once.
  maxPerRun Int @default(100)

  /// Running totals, so the page can show the rule is doing something.
  reassignedCount Int       @default(0)
  lastRunAt       DateTime?

  createdById String
  createdBy   User   @relation("ReassignmentRuleCreatedBy", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}

/// Floor rules for checking in: how late is late, and where from.
///
/// A singleton, like PriorityAssignmentSetting. Off by default in both halves,
/// so installing this release changes nobody's day until an admin turns it on.
model AttendancePolicy {
  id String @id @default("singleton")

  /// ─── Late check-in ──────────────────────────────────────────────────────
  /// Agents who check in after this time get no FRESH leads for the day — only
  /// leads that already carry feedback — and re-assignment rules skip them.
  /// An agent who has not checked in at all is treated the same way.
  lateCutoffEnabled Boolean @default(false)
  /// IST wall clock. Stored as hour/minute rather than an instant for the same
  /// reason EmailRule does: the server runs UTC and an instant would drift.
  lateCutoffHour    Int     @default(10)
  lateCutoffMinute  Int     @default(0)

  /// ─── Geofence ───────────────────────────────────────────────────────────
  /// WFO staff must be within `geofenceRadiusM` of the office to check in.
  /// WFH staff are exempt — geofencing them would lock them out of the CRM
  /// entirely, since the attendance gate blocks lead work without a check-in.
  geofenceEnabled Boolean @default(false)
  officeLatitude  Float?
  officeLongitude Float?
  geofenceRadiusM Int     @default(300)

  updatedById String?
  updatedBy   User?    @relation("AttendancePolicyUpdatedBy", fields: [updatedById], references: [id])
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())
}

model AdminActionUnlock {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@unique([userId, action])
  @@index([expiresAt])
}

// Caches a full year's holiday list from the Calendarific API, one row per
// (country, year). Fetched at most once per year — the API returns every
// holiday for the whole year in a single call, so there's no need to hit it
// daily; "today's holiday" is just a lookup against the cached data. Keeps
// us far under Calendarific's 500 calls/month free-tier limit.
model HolidayCache {
  id        String   @id @default(cuid())
  country   String
  year      Int
  data      Json
  fetchedAt DateTime @default(now())

  @@unique([country, year])
}

// A Super-Admin-configured outbound push — e.g. "send every new referral
// lead to the LMS". The endpoint/headers/body are fully editable from the
// UI (not hardcoded) since the receiving API's contract can change at any
// time; `bodyTemplate` is a raw JSON string containing literal values mixed
// with {{field}} placeholders, rendered against the triggering lead at send
// time (see lib/lead-integration-template.ts).
model LeadIntegration {
  id           String                 @id @default(cuid())
  name         String
  isActive     Boolean                @default(false) // off until an admin explicitly verifies it via Test & Send
  trigger      LeadIntegrationTrigger @default(REFERRAL_CREATED)
  method       String                 @default("POST")
  url          String
  headers      Json // [{ key, value, isSecret }] — isSecret values are AES-256-GCM encrypted, see lib/integration-crypto.ts
  queryParams  Json // [{ key, value }]
  bodyTemplate String                 @db.Text
  timeoutMs    Int                    @default(10000)

  /// Set for a per-college push (trigger LEAD_CREATED): the COLLEGE option whose
  /// leads this integration receives, matched against Lead.college. SetNull on
  /// delete leaves an inert integration — the engine never pushes without a
  /// college — rather than one that would match every lead.
  collegeOptionId String?
  collegeOption   DropdownOption? @relation("CollegeIntegrations", fields: [collegeOptionId], references: [id], onDelete: SetNull)
  pushWhen        LeadPushWhen    @default(ON_INSERT)
  /// Delivery attempts per lead for a retryable failure (network error,
  /// timeout, HTTP 408/425/429/5xx). A 4xx is the college rejecting the data,
  /// so it is not retried automatically.
  maxAttempts     Int             @default(3)
  /// AES-256-GCM encrypted. When set, every request carries X-CRM-Timestamp and
  /// X-CRM-Signature (HMAC-SHA256 of "<timestamp>.<body>") so the college can
  /// verify the push really came from this CRM.
  signingSecret   String?
  /// Set when a Test & Send succeeds; cleared whenever the request config
  /// changes. A per-college integration cannot be switched on without it.
  verifiedAt      DateTime?

  createdById String
  createdBy   User   @relation("LeadIntegrationCreatedBy", fields: [createdById], references: [id])

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  logs   LeadIntegrationLog[]
  pushes LeadIntegrationPush[]

  @@index([trigger, isActive])
  @@index([collegeOptionId, trigger, isActive])
}

/// One row per lead successfully delivered by an integration. This — not the
/// log, which may be pruned and holds failures and tests too — is what stops a
/// lead being sent twice, and what "already sent" means for a backfill.
model LeadIntegrationPush {
  integrationId String
  integration   LeadIntegration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  leadId        String
  lead          Lead            @relation(fields: [leadId], references: [id], onDelete: Cascade)
  pushedAt      DateTime        @default(now())

  @@id([integrationId, leadId])
  @@index([leadId])
}

// One row per push attempt (automatic, test, or retry) — kept even on
// success so admins can audit exactly what was sent to a third party.
model LeadIntegrationLog {
  id            String          @id @default(cuid())
  integrationId String
  integration   LeadIntegration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  // Nullable: a test send against synthetic sample data has no real lead.
  leadId String?
  lead   Lead?   @relation(fields: [leadId], references: [id], onDelete: SetNull)

  isTest       Boolean @default(false)
  retryOfLogId String? // set when this row is a manual retry of an earlier failed attempt
  attempt      Int     @default(1) // automatic delivery attempt number for this lead

  requestUrl     String
  requestMethod  String
  requestHeaders Json
  requestBody    String  @db.Text
  responseStatus Int?
  responseBody   String? @db.Text
  success        Boolean
  errorMessage   String?

  attemptedAt DateTime @default(now())

  @@index([integrationId])
  @@index([leadId])
  @@index([success])
  @@index([attemptedAt])
}

/// What a scheduled email contains.
enum EmailReportType {
  /// One email per agent, carrying only that agent's own numbers.
  AGENT_PERFORMANCE
  /// One email listing every agent in scope — the management view.
  TEAM_SUMMARY
  /// Login details and getting-started links for a newly created user. Sent
  /// automatically when the account is made, and re-sendable from a rule.
  WELCOME
  /// The Reports page's outcome table: leads worked in the period, counted once
  /// under their latest follow-up, plus the university count and total.
  FEEDBACK_SUMMARY
  /// The same leads split by college — dialed, connected, connected %, and a
  /// column per outcome.
  COLLEGE_WISE
  /// The KPI scoreboard in wide form: one row per agent, achieved / target / %
  /// / points earned for every KPI, then Total Score, Max Score, Score % and a
  /// grade. The emailed twin of the KPI Targets page's download.
  AGENT_WISE
  /// Dialled, connected and talktime for every agent across four windows —
  /// today, this week, this month and all time — against the daily mandate.
  OVERALL_CALLING
  /// Every table in one email, in a fixed order, under a subject that names the
  /// month. The only recurring report whose subject changes.
  ALL_REPORTS
}

enum EmailFrequency {
  DAILY
  WEEKLY
  MONTHLY
  QUARTERLY
}

/// How the "To" line is resolved when the rule runs.
enum EmailAudience {
  /// Addresses typed in by an admin.
  FIXED
  /// Everyone holding one of the chosen roles, using their CRM email.
  BY_ROLE
  /// A separate email to each agent in scope, addressed to them.
  EACH_AGENT
}

/// One scheduled email. Everything an admin can decide lives here rather than in
/// code: what it contains, when it goes, who receives it and who is copied.
model EmailRule {
  id   String @id @default(cuid())
  name String

  reportType EmailReportType
  frequency  EmailFrequency

  /// Send time as IST wall clock. The server runs UTC, so storing an instant
  /// would drift the moment anything about the box changed; an hour and minute
  /// in the timezone the business actually works in cannot.
  sendHour   Int
  sendMinute Int  @default(0)
  /// 1 = Monday … 7 = Sunday. Weekly rules only.
  weekday    Int?
  /// 1–28 only, so a monthly rule cannot silently skip February.
  dayOfMonth Int?

  audience  EmailAudience
  /// [{ emailid, name }] — used when the audience is FIXED.
  toEmails  Json          @default("[]")
  /// Role names, used when the audience is BY_ROLE.
  toRoles   String[]
  ccEmails  Json          @default("[]")
  ccRoles   String[]
  bccEmails Json          @default("[]")

  /// Limit the report to one Team Leader's agents. Null covers everyone.
  scopeTlId String?
  scopeTl   User?   @relation("EmailRuleScopeTl", fields: [scopeTlId], references: [id], onDelete: SetNull)

  /// Overrides the report's own subject line. Null means use the default from
  /// lib/email-subjects.ts. Kept constant per rule so the mail threads — see
  /// the THREADING note in lib/email-reports.ts.
  subject   String?
  attachCsv Boolean @default(false)
  isActive  Boolean @default(true)

  /// The period this rule last completed, e.g. "2026-08-22" or "2026-W34".
  /// Compared against the current period so a rule fires once per period even
  /// if the scheduler runs every few minutes or the box was down at the time.
  lastPeriodKey String?
  lastRunAt     DateTime?

  createdById String
  createdBy   User   @relation("EmailRuleCreatedBy", fields: [createdById], references: [id])

  logs      EmailLog[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([isActive])
}

/// Every send attempt. Without this nobody can answer "did the 9am report go?",
/// and the provider returns HTTP 200 on failure, so the outcome has to be
/// recorded from the response body at the time.
model EmailLog {
  id     String     @id @default(cuid())
  ruleId String?
  rule   EmailRule? @relation(fields: [ruleId], references: [id], onDelete: SetNull)

  reportType  EmailReportType
  periodLabel String
  subject     String

  toEmails  String[]
  ccEmails  String[]
  bccEmails String[]

  success          Boolean
  /// The provider's own tracking id, for chasing a specific message with them.
  providerGuid     String?
  providerResponse Json?
  error            String?

  sentAt DateTime @default(now())

  @@index([ruleId, sentAt])
  @@index([sentAt])
}

// ─── University profiles ──────────────────────────────────────────────────────
//
// The universities this team sells, maintained by hand under Manage
// Universities. Every section below is a table rather than a JSON blob
// because the data team edits them row by row: a row needs its own id to be
// reordered or removed, and a column needs its own type to be validated.
//
// Each child table carries sortOrder, because the order the data team enters
// rows in is the order a counsellor should read them, and cascades on delete,
// so removing a university takes its profile with it.
model University {
  id   String @id @default(cuid())
  /// The display name, and the key a counsellor searches by.
  name String @unique
  slug String @unique

  establishmentYear String?
  /// Public State, Central, Private or Deemed — see UNIVERSITY_TYPES in
  /// lib/university-fields.ts, which is what the form offers.
  universityType    String?
  campusAddress     String?
  /// Derived from the address on save, for the State filter on the listing.
  city              String?
  state             String?
  email             String?
  contactNumber     String?
  whatsappNumber    String?
  whatsappLink      String?
  websiteLink       String?

  isActive Boolean @default(true)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  updatedById String?
  updatedBy   User?    @relation("UniversityUpdatedBy", fields: [updatedById], references: [id])

  accreditations   UniversityAccreditation[]
  programmes       UniversityProgramme[]
  specializations  UniversitySpecialization[]
  fees             UniversityProgrammeFee[]
  faqs             UniversityFaq[]
  partners         UniversityPartner[]
  locations        UniversityLocation[]
  scholarships     UniversityScholarship[]
  faculty          UniversityFaculty[]
  rankings         UniversityRanking[]
  learningFeatures UniversityLearningFeature[]
  careerServices   UniversityCareerService[]
  sampleDegrees    UniversitySampleDegree[]
  brochures        UniversityBrochure[]

  @@index([isActive])
  @@index([state])
}

/// 2. Accreditations and Recognitions. Also what the listing's "Approved by"
/// filter matches on, which is why body is indexed.
model UniversityAccreditation {
  id           String     @id @default(cuid())
  universityId String
  university   University @relation(fields: [universityId], references: [id], onDelete: Cascade)
  body         String
  status       String?
  sourceLink   String?
  sortOrder    Int        @default(0)

  @@index([universityId])
  @@index([body])
}

/// 3. Programmes Summary — the course families on offer, which the cards list
/// and the Course and Level filters match on.
model UniversityProgramme {
  id                  String     @id @default(cuid())
  universityId        String
  university          University @relation(fields: [universityId], references: [id], onDelete: Cascade)
  programme           String
  fullName            String?
  level               String?
  durationMonths      Int?
  specializationCount Int?
  source              String?
  link                String?
  sortOrder           Int        @default(0)

  @@index([universityId])
  @@index([programme])
  @@index([level])
}

/// 4. Programme Specializations. Matched to a programme by name, which is how
/// the detail panel groups them under their course.
model UniversitySpecialization {
  id             String     @id @default(cuid())
  universityId   String
  university     University @relation(fields: [universityId], references: [id], onDelete: Cascade)
  programme      String
  specialization String
  officialLink   String?
  sortOrder      Int        @default(0)

  @@index([universityId])
}

/// 5 and 6. Undergraduate and Postgraduate fees — one table, told apart by
/// `level`, because every column is the same and splitting them would mean
/// two of everything downstream.
///
/// Money is stored as whole rupees rather than as typed text, so the fees
/// filter can compare it and every figure renders in one format. The form
/// accepts "1,80,000" or "₹1,80,000" and keeps the number.
model UniversityProgrammeFee {
  id             String     @id @default(cuid())
  universityId   String
  university     University @relation(fields: [universityId], references: [id], onDelete: Cascade)
  /// "Undergraduate" or "Postgraduate".
  level          String
  programme      String
  duration       String?
  totalFee       Int?
  annualFee      Int?
  perSemesterFee Int?
  emiStarting    Int?
  eligibility    String?
  officialUrl    String?
  sortOrder      Int        @default(0)

  @@index([universityId])
  @@index([level])
  @@index([totalFee])
}

/// 7. Frequently Asked Questions.
model UniversityFaq {
  id           String     @id @default(cuid())
  universityId String
  university   University @relation(fields: [universityId], references: [id], onDelete: Cascade)
  question     String
  answer       String?
  sortOrder    Int        @default(0)

  @@index([universityId])
}

/// 8. Company Partners / Recruiters.
model UniversityPartner {
  id           String     @id @default(cuid())
  universityId String
  university   University @relation(fields: [universityId], references: [id], onDelete: Cascade)
  name         String
  sortOrder    Int        @default(0)

  @@index([universityId])
}

/// 9. Location and Transportation.
model UniversityLocation {
  id            String     @id @default(cuid())
  universityId  String
  university    University @relation(fields: [universityId], references: [id], onDelete: Cascade)
  transportType String
  nearestStop   String?
  distance      String?
  notes         String?
  sortOrder     Int        @default(0)

  @@index([universityId])
}

/// 10. Scholarships and Discounts.
model UniversityScholarship {
  id           String     @id @default(cuid())
  universityId String
  university   University @relation(fields: [universityId], references: [id], onDelete: Cascade)
  name         String
  type         String?
  eligibility  String?
  sourceLink   String?
  sortOrder    Int        @default(0)

  @@index([universityId])
}

/// 11. Top Faculties.
model UniversityFaculty {
  id            String     @id @default(cuid())
  universityId  String
  university    University @relation(fields: [universityId], references: [id], onDelete: Cascade)
  name          String
  designation   String?
  qualification String?
  description   String?
  sourceLink    String?
  sortOrder     Int        @default(0)

  @@index([universityId])
}

/// 12. Global Rankings and Recognition.
model UniversityRanking {
  id           String     @id @default(cuid())
  universityId String
  university   University @relation(fields: [universityId], references: [id], onDelete: Cascade)
  body         String
  details      String?
  year         String?
  sourceLink   String?
  sortOrder    Int        @default(0)

  @@index([universityId])
}

/// 13. Learning Experience and LMS Features.
model UniversityLearningFeature {
  id           String     @id @default(cuid())
  universityId String
  university   University @relation(fields: [universityId], references: [id], onDelete: Cascade)
  feature      String
  capability   String?
  benefit      String?
  officialLink String?
  sortOrder    Int        @default(0)

  @@index([universityId])
}

/// 14. Career Services and Placement Assistance.
model UniversityCareerService {
  id           String     @id @default(cuid())
  universityId String
  university   University @relation(fields: [universityId], references: [id], onDelete: Cascade)
  feature      String
  capability   String?
  impact       String?
  portalLink   String?
  sortOrder    Int        @default(0)

  @@index([universityId])
}

/// 15. Sample Degree — a title, a description and an uploaded image.
///
/// The image is stored outside /public and served by an authenticated route,
/// the same arrangement receipts use: nothing in storage is reachable without
/// a session. See lib/university-storage.ts.
model UniversitySampleDegree {
  id               String     @id @default(cuid())
  universityId     String
  university       University @relation(fields: [universityId], references: [id], onDelete: Cascade)
  title            String
  description      String?
  fileOriginalName String?
  /// Path relative to the private storage root; never a URL.
  filePath         String?
  fileMimeType     String?
  sortOrder        Int        @default(0)

  @@index([universityId])
}

/// 16. Brochures. The file is a PDF as often as not, which is why these do
/// not live with the sample degrees: same shape, different accepted types.
model UniversityBrochure {
  id               String     @id @default(cuid())
  universityId     String
  university       University @relation(fields: [universityId], references: [id], onDelete: Cascade)
  name             String
  fileOriginalName String?
  filePath         String?
  fileMimeType     String?
  sortOrder        Int        @default(0)

  @@index([universityId])
}
